<?xml version="1.0" encoding="utf-8"?>
<!--
  LiVi Cut MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build filmcraft.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files and a Start Menu shortcut. No file associations.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif ?>
  <Package
      Name="LiVi Cut"
      Manufacturer="LiVi"
      Version="$(var.Version)"
      UpgradeCode="0C0CA192-BA41-43D4-BF00-08146A833AD7"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="LiVi Cut video editor" Manufacturer="LiVi" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of LiVi Cut is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="FilmcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="FilmcraftIcon.ico" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="LiVi Cut" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="LiVi Cut" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif ?>
      <ComponentGroupRef Id="FilmcraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif ?>
    <ComponentGroup Id="FilmcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="FilmcraftApp" Guid="CE301100-38F2-42C6-B196-B6DFC0389964">
        <File Id="FilmcraftNotice" Source="$(var.BinDir)\NOTICE" KeyPath="no" />
        <File Id="FilmcraftExe" Source="$(var.BinDir)\livi-cut.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="LiVi Cut"
              Description="LiVi Cut video editor" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="FilmcraftIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\livi-cut.exe" Value="[#FilmcraftExe]" Type="string" />
      </Component>

      <Component Id="FilmcraftCli">
        <File Id="FilmcraftCliExe" Source="$(var.BinDir)\livi-cut-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
